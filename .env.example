# Copy to .env and fill in locally. Use shell-compatible assignments;
# quote values containing spaces, $, #, or other shell characters.
# Apply only to one command: ./scripts/with-env <command> [arguments...]

# Cloudflare Pages deployment/admin (not needed for local gameplay).
CLOUDFLARE_API_TOKEN=''
CLOUDFLARE_ACCOUNT_ID=''

# Optional Render deployment/admin (not needed for local gameplay).
RENDER_API_KEY=''

# Modal: both values must belong to the intended workspace.
MODAL_TOKEN_ID=''
MODAL_TOKEN_SECRET=''
# Training container CPU count; this is NOT a spending limit.
IBFLIP_MODAL_CPU=64

# Local development only: no reverse proxy. Render defaults to 1 in the app.
TRUSTED_PROXY_HOPS=0
